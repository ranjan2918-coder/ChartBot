# --- Lost Government Benefits AI Chatbot - Backend Config ---

PORT=5000

# API Keys (Paste yours here)
GEMINI_API_KEY=your_gemini_key_here
OPENAI_API_KEY=your_openai_key_here
WISPRFLOW_API_KEY=your_wispr_key_here

# Model Selection
